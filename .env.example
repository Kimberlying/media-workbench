# 复制成 .env.local（本地）或填进 Vercel 的 Environment Variables（线上）。
# 带「必填」的不配就跑不起来；其余不配时对应功能关闭。

# ── 应用 ──
# 必填。线上填 Vercel 给的域名，例如 https://media-workbench.vercel.app；登录回调和 X 授权回调都用它
APP_URL=http://localhost:3000

# ── Supabase（Project Settings → API）──
# 必填
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 必填。只在服务端用，不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# ── 平台令牌加密 ──
# 必填。32 字节随机数的 base64，生成：openssl rand -base64 32
# 上线后不要再换，换了已连接账号的令牌就解不开，要重新连接
TOKEN_ENCRYPTION_KEY=

# ── 模型 ──
# 不配 LLM_GATEWAY_URL 时直连 xAI 和 Gemini（推荐，少托管一个服务）
# 必填。xAI 控制台 console.x.ai → API Keys；资讯雷达搜 X 和短推都用它
XAI_API_KEY=
# 资讯雷达搜 X 和别名 grok 用的模型，默认 grok-4.7
XAI_MODEL=
# 必填。Google AI Studio aistudio.google.com → Get API key；打标签、选题、长文、小红书用它
GEMINI_API_KEY=
# 别名 gemini-flash 用的模型，默认 gemini-3.8-flash
GEMINI_MODEL=
# 想走 LiteLLM 代理时才填（见 litellm/config.yaml），填了就全部走代理，搜 X 仍直连 xAI
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
# 临时给某个环节换模型，例如 {"copy.post":"grok"}
LLM_MODEL_OVERRIDES=

# ── 素材（链接转写）──
# dash.supadata.ai 注册后自动生成；「素材」页贴视频、播客链接转文字稿用。不填只是这个页面用不了
# 有字幕 1 积分一条，没字幕 AI 转写每分钟 2 积分，免费档每月 100 积分
SUPADATA_API_KEY=

# ── Inngest（定时任务）──
# 线上必填：Vercel 装 Inngest 集成会自动写入；本地跑 inngest-cli dev 时不用填
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── 资讯雷达推送与日报 ──
# Discord 频道 → 编辑频道 → 整合 → Webhook → 复制 URL；不填就不推
DISCORD_WEBHOOK_URL=
# Mac 上 obsidian_sync.py 拉日报用的口令，自己定一串随机数：openssl rand -hex 24
DIGEST_TOKEN=

# ── X 账号连接（developer.x.com → 你的 App → User authentication settings）──
# 回调地址填 {APP_URL}/api/connect/x/callback，权限选 Read and write，类型选 Web App
X_CLIENT_ID=
X_CLIENT_SECRET=

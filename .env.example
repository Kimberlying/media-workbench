# 复制成 .env.local（本地）或填进 Vercel 的 Environment Variables（线上）。
# 带「必填」的不配就跑不起来；其余不配时对应功能关闭。

# ── 应用 ──
# 必填。线上填 Vercel 给的域名，例如 https://media-workbench.vercel.app；登录回调和 X 授权回调都用它
APP_URL=http://localhost:3000

# ── Supabase（Project Settings → API）──
# 必填
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 必填。只在服务端用，不要加 NEXT_PUBLIC_ 前缀
SUPABASE_SERVICE_ROLE_KEY=

# ── 平台令牌加密 ──
# 必填。32 字节随机数的 base64，生成：openssl rand -base64 32
# 上线后不要再换，换了已连接账号的令牌就解不开，要重新连接
TOKEN_ENCRYPTION_KEY=

# ── 模型 ──
# 不配 LLM_GATEWAY_URL 时直连 xAI 和 Gemini（推荐，少托管一个服务）
# 可选。xAI 控制台 console.x.ai → API Keys；只有资讯雷达按档案搜 X 用它，不配就只跑固定信源
XAI_API_KEY=
# 资讯雷达搜 X 和别名 grok 用的模型，默认 grok-4.7
XAI_MODEL=
# 必填。Google AI Studio aistudio.google.com → Get API key；语音转写、打标签、选题、全部文案都用它
GEMINI_API_KEY=
# 别名 gemini-flash 用的模型，默认 gemini-3.8-flash
GEMINI_MODEL=
# Telegram 线配图用的出图模型，默认 gemini-nano-banana-2.1；填 off 一律不出图
GEMINI_IMAGE_MODEL=
# 可选。在「账号与档案」里把配图改成 ChatGPT 时才要：platform.openai.com → API keys（和 ChatGPT 会员分开计费）
OPENAI_API_KEY=
# ChatGPT 出图用的模型，默认 gpt-image-2
OPENAI_IMAGE_MODEL=
# 想走 LiteLLM 代理时才填（见 litellm/config.yaml），填了就全部走代理，搜 X 仍直连 xAI
LLM_GATEWAY_URL=
LLM_GATEWAY_KEY=
# 临时给某个环节换模型，例如 {"copy.x_post":"grok"}
LLM_MODEL_OVERRIDES=

# ── 素材（链接转写）──
# dash.supadata.ai 注册后自动生成；「素材」页贴视频、播客链接转文字稿用。不填只是这个页面用不了
# 有字幕 1 积分一条，没字幕 AI 转写每分钟 2 积分，免费档每月 100 积分
SUPADATA_API_KEY=

# ── Inngest（定时任务）──
# 线上必填：Vercel 装 Inngest 集成会自动写入；本地跑 inngest-cli dev 时不用填
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── 资讯雷达推送与日报 ──
# Discord 频道 → 编辑频道 → 整合 → Webhook → 复制 URL；不填就不推
DISCORD_WEBHOOK_URL=
# Mac 上 obsidian_sync.py 拉日报用的口令，自己定一串随机数：openssl rand -hex 24
DIGEST_TOKEN=

# ── X 账号连接（developer.x.com → 你的 App → User authentication settings）──
# 回调地址填 {APP_URL}/api/connect/x/callback，权限选 Read and write，类型选 Web App
X_CLIENT_ID=
X_CLIENT_SECRET=

# ── Buffer（LinkedIn、Instagram 经 Buffer 发布）──
# Buffer 网页 → Settings → API（个人 API key）；填了「账号与档案」里就能直接选 Buffer 频道
BUFFER_API_KEY=

# ── Telegram 审核（推到 TG，在 TG 里点按钮交给 Buffer）──
# @BotFather 新建机器人拿到的 token。一个机器人只能有一个 webhook：如果 Mac 上的旧脚本还在用同一个机器人收消息，先另建一个
TELEGRAM_BOT_TOKEN=
# 你和机器人的私聊 id：先给机器人发一句话，再打开 https://api.telegram.org/bot<token>/getUpdates 看 chat.id
TELEGRAM_CHAT_ID=
# setWebhook 时的 secret_token，自己定一串：openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
